# ============================================================
#  Salin file ini menjadi .env lalu isi nilainya.
#  JANGAN commit file .env ke GitHub (sudah ada di .gitignore).
#  Di server (Render), isi nilai yang sama di menu Environment.
# ============================================================

# --- DATABASE (wajib) ---------------------------------------
# Lokal (Postgres.app): ganti "saras" dengan hasil perintah `whoami`
DATABASE_URL="postgresql://saras@localhost:5432/dubidu"
# Neon: DATABASE_URL = connection string "Pooled", DIRECT_URL = "Direct" (tanpa -pooler)
# DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# --- KEAMANAN (wajib) ---------------------------------------
# Buat string acak: openssl rand -hex 32
JWT_SECRET="ganti-dengan-string-acak-panjang"
JWT_EXPIRES_IN="30d"

# --- SERVER -------------------------------------------------
PORT=4000
# URL publik backend (link file upload & halaman selesai bayar)
PUBLIC_URL="http://localhost:4000"
# Origin web admin yang boleh akses API, pisahkan koma. Kosong = semua.
CORS_ORIGINS=""
# Harus sama dengan "scheme" di app.json frontend (kembali ke aplikasi setelah bayar)
APP_SCHEME="duwbiduw"

# --- PENYIMPANAN FILE (wajib di server online) --------------
# cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=""

# --- AI: Doobie chat + AI matching --------------------------
# Kosong = Doobie membalas pesan bawaan & matching memakai skor aturan saja.
ANTHROPIC_API_KEY=""
DOOBIE_MODEL="claude-opus-5-5"
MATCHING_MODEL="claude-opus-5-5"

# --- PEMBAYARAN ---------------------------------------------
# "manual"   = transfer ke QRIS GoPay / rekening bank + upload bukti, dikonfirmasi admin (dipakai sekarang)
# "midtrans" = payment gateway otomatis (nanti, setelah akun Midtrans disetujui)
# "mock"     = demo, tombol bayar langsung lunas
PAYMENT_MODE="manual"
# Batas waktu transfer manual sebelum pesanan batal otomatis (menit)
MANUAL_PAYMENT_EXPIRY_MINUTES=120

# --- Midtrans (opsional, untuk nanti) ---
# Sandbox: Dashboard Midtrans (mode Sandbox) > Settings > Access Keys > Server Key (SB-Mid-server-...)
MIDTRANS_SERVER_KEY=""
# "true" hanya setelah akun Midtrans production disetujui & server key production dipakai
MIDTRANS_IS_PRODUCTION="false"
PLATFORM_FEE_PERCENT=10

# --- EMAIL: lupa password -----------------------------------
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=emailmu@gmail.com,
#        SMTP_PASS=App Password 16 huruf (bukan password Gmail biasa)
SMTP_HOST=""
SMTP_PORT=465
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="DUBIDU <emailmu@gmail.com>"

# --- VIDEO / VOICE CALL: Daily.co ---------------------------
# Kosong = memakai link Jitsi Meet sebagai cadangan
DAILY_API_KEY=""

# --- PUSH NOTIFICATION: Expo --------------------------------
# Opsional, hanya jika "Enhanced push security" diaktifkan di expo.dev
EXPO_ACCESS_TOKEN=""

# --- LAIN-LAIN ----------------------------------------------
# "off" = matikan batas 1 anak pada akun gratis
FREE_CHILD_LIMIT=""
# "false" = seed hanya master data, tanpa akun demo
SEED_DEMO="true"
